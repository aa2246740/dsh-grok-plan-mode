{
  "name": "dsh-grok-plan-mode",
  "version": "0.1.2",
  "description": "Grok Build Plan Mode for DeepSeek Harness. Replaces official DSH Plan with a hard edit gate.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa2246740/dsh-grok-plan-mode.git"
  },
  "homepage": "https://github.com/aa2246740/dsh-grok-plan-mode",
  "bugs": {
    "url": "https://github.com/aa2246740/dsh-grok-plan-mode/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "client": {
      "entry": "./lib/client.js",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "node scripts/build-server.mjs",
    "build:client": "tsdown --config tsdown.config.ts",
    "test": "node --experimental-strip-types --test tests/tracker.spec.ts tests/reminders.spec.ts tests/gate.spec.ts tests/review.spec.ts tests/plan-file.spec.ts tests/fold.spec.ts tests/prompts.spec.ts tests/package-contract.spec.ts",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "check": "npm test && npm run typecheck && npm run build",
    "test:replacement": "node --experimental-strip-types tests/global-replacement.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plan-mode",
    "grok-build",
    "dsh-plugin"
  ],
  "files": [
    "src",
    "lib/index.js",
    "lib/client.js",
    "overlays",
    "cordis.yml",
    "dshx.yml",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-scope": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-user-questions": "^0.1.2-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
