{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": [
    "src/types.ts",
    "src/tracker.ts",
    "src/reminders.ts",
    "src/gate.ts",
    "src/plan-file.ts",
    "src/review.ts",
    "src/prompts.ts",
    "src/fold.ts",
    "tests/**/*.ts"
  ]
}
